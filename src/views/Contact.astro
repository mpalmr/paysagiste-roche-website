---
import { site, type Lang } from '../data/site';
import { t } from '../data/i18n';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import FormScript from '../components/FormScript.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const all = t(lang);
const d = all.contact;
const f = d.form;
import { quoteHref, quoteRel } from '../lib/paths';
---
<PageHead title={d.title} lead={d.lead} />

<section class="ct-sec">
  <div class="wrap ct">
    <div class="ct-info">
      <a class="big-phone" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>

      <dl class="info">
        <div>
          <dt>{d.addressLabel}</dt>
          <dd>{site.street}<br />{site.city} ({site.region}) {site.postal}<br />
            <a href={site.mapsUrl} rel="noopener"><Icon name="pin" />{d.map}</a></dd>
        </div>
        <div>
          <dt>{d.emailLabel}</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>{all.footer.hours}</dt>
          <dd>
            <table class="hours">
              <tbody>{all.hours.map(([day, h]) => <tr><th scope="row">{day}</th><td>{h}</td></tr>)}</tbody>
            </table>
          </dd>
        </div>
        <div>
          <dt>{d.areasTitle}</dt>
          <dd>{d.areas}</dd>
        </div>
      </dl>
    </div>

    <div class="ct-act">
      {site.quotePortal && (
        <div class="quote-box on-dark">
          <h2>{d.quoteTitle}</h2>
          <p>{d.quoteText}</p>
          <a class="btn btn-sun" href={quoteHref(lang)} rel={quoteRel}><Icon name="doc" />{all.cta.quote}</a>
        </div>
      )}

      <form
        id="ecrire" class="ct-form" data-ajax data-send="query" novalidate method="get" action={site.contactEndpoint || undefined}
        data-sent={f.sent} data-demo={f.demo} data-error={f.error} data-required={f.required}
        data-bad-email={f.badEmail} data-too-short={f.tooShort}
        aria-labelledby="form-h"
      >
        <h2 id="form-h">{site.quotePortal ? d.formTitle : d.formTitleQuote}</h2>
        {!site.quotePortal && <p class="form-intro">{d.formIntroQuote}</p>}
        <input type="hidden" name="language" value={lang} />
        <div class="form-grid two">
          <div class="field">
            <label for="c-name">{f.name}</label>
            <input class="input" id="c-name" name="name" autocomplete="name" required aria-describedby="c-name-err" />
            <p class="err" id="c-name-err"></p>
          </div>
          <div class="field">
            <label for="c-company">{f.company}</label>
            <input class="input" id="c-company" name="entreprise" autocomplete="organization" />
          </div>
          <div class="field full">
            <label for="c-email">{f.email}</label>
            <input class="input" id="c-email" name="EMAIL" type="email" autocomplete="email" inputmode="email" required aria-describedby="c-email-err" />
            <p class="err" id="c-email-err"></p>
          </div>
          <div class="field full">
            <label for="c-msg">{f.message}</label>
            <textarea
              class="input" id="c-msg" name="message" required
              minlength={site.messageMin} maxlength={site.messageMax}
              aria-describedby="c-msg-count c-msg-err"
            ></textarea>
            <p class="count" id="c-msg-count" data-template={f.count(0, site.messageMax)} data-max={site.messageMax}>{f.count(0, site.messageMax)}</p>
            <p class="err" id="c-msg-err"></p>
          </div>
          <div class="full">
            <button class="btn btn-green" type="submit">{f.send}</button>
          </div>
          <p class="form-status full" role="status" tabindex="-1"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<FormScript />

<style>
  .ct-sec { padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .ct { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .big-phone {
    display: inline-flex; align-items: center; gap: 0.75rem; color: var(--thuya);
    text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: transparent; text-underline-offset: 0.18em;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3rem); font-weight: 800; line-height: 1;
     letter-spacing: -0.02em; margin-bottom: 2rem;
  }
  .big-phone :global(svg) { width: 0.8em; height: 0.8em; color: var(--soleil); }
  .big-phone { padding-block: 0.4rem; }
  .big-phone:hover { text-decoration-color: var(--soleil); }
  .info { margin: 0; display: grid; gap: 1.5rem; }
  .info > div { border-top: 2px solid var(--thuya); padding-top: 0.85rem; }
  .info dt { font-weight: 700; margin-bottom: 0.35rem; }
  .info dd { margin: 0; color: var(--mousse); }
  .info dd a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600; margin-top: 0.25rem; }
  .info :global(svg) { width: 1em; height: 1em; }
  .hours { border-collapse: collapse; }
  .hours th { text-align: left; font-weight: 500; padding: 0.15rem 1.25rem 0.15rem 0; color: var(--ardoise); }
  .hours td { padding: 0.15rem 0; }

  .ct-act { display: grid; gap: 2rem; }
  .form-intro { color: var(--mousse); margin-top: -0.75rem; }
  .count { font-size: var(--step--1); color: var(--mousse); text-align: right; }
  .count[data-near='true'] { color: #8a4b00; font-weight: 600; }
  .quote-box { border-radius: var(--radius-s); padding: clamp(1.5rem, 4vw, 2.25rem); display: grid; gap: 1rem; justify-items: start; }
  .quote-box h2, .ct-form h2 { font-size: var(--step-2); }
  .quote-box p { color: #cfdbd2; }
  .ct-form { display: grid; gap: 1.5rem; background: var(--pierre); border-radius: var(--radius-s); padding: clamp(1.5rem, 4vw, 2.25rem); border: 1px solid rgba(31, 37, 34, 0.1); }
  @media (max-width: 860px) { .ct { grid-template-columns: 1fr; } }
</style>

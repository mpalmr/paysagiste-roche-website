---
import { site, type Lang } from '../data/site';
import { t } from '../data/i18n';
import { href, serviceAnchors, quoteHref, quoteRel } from '../lib/paths';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang);
const g = d.services.groups;
const a = serviceAnchors[lang];

const steps = [
  { key: 'design', verb: lang === 'fr' ? 'Concevoir' : 'Plan', img: '/images/rendu-maison-1.webp', w: 398, h: 152, g: g.design },
  { key: 'build', verb: lang === 'fr' ? 'Construire' : 'Build', img: '/images/terrasse-dalles.webp', w: 588, h: 442, g: g.build },
  { key: 'care', verb: lang === 'fr' ? 'Entretenir' : 'Maintain', img: '/images/allee-piscine.webp', w: 588, h: 442, g: g.care },
] as const;

const featured = [
  { src: '/images/piscine-vivaces.webp', w: 960, h: 682, fr: 'Piscine bordée de graminées et d’échinacées', en: 'Pool edged with grasses and coneflowers' },
  { src: '/images/escalier-piscine.webp', w: 588, h: 442, fr: 'Escalier en bois et dalles de pierre', en: 'Wood stairs and stone slabs' },
  { src: '/images/cour-pave-cloture.webp', w: 588, h: 440, fr: 'Cour en pavé et clôture de cèdre', en: 'Paver yard and cedar fence' },
  { src: '/images/eclairage-6.webp', w: 504, h: 504, fr: 'Jardin d’eau éclairé', en: 'Lit water garden' },
  { src: '/images/terrasse-cedre.webp', w: 588, h: 440, fr: 'Terrasse et banc-jardinière en cèdre', en: 'Cedar deck and planter bench' },
];
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1>{d.home.title}</h1>
      <p class="lead">{d.home.lead}</p>
      <div class="actions">
        <a class="btn btn-sun" href={quoteHref(lang)} rel={quoteRel}><Icon name="doc" />{d.cta.quote}</a>
        <a class="btn btn-line" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
      </div>
      <p class="since">{d.home.since}</p>
    </div>
    <div class="arch-wrap">
      <div class="arch">
        <img src="/images/piscine-vivaces.webp" width="960" height="682" alt={d.home.heroAlt} fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<section class="section steps-sec" aria-labelledby="steps-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="steps-h">{d.home.servicesTitle}</h2>
      <p class="lead">{d.home.servicesLead}</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <a class="step-link" href={href(lang, 'services', a[s.key])}>
            <img src={s.img} width={s.w} height={s.h} alt="" loading="lazy" />
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.verb}</h3>
            <p class="step-title">{s.g.title}</p>
            <p>{s.g.short}</p>
          </a>
        </li>
      ))}
    </ol>
    <p><a class="textlink" href={href(lang, 'services')}>{d.cta.allServices}</a></p>
  </div>
</section>

<section class="section on-dark" aria-labelledby="feat-h">
  <div class="wrap">
    <div class="section-head feat-head">
      <div>
        <h2 id="feat-h">{d.home.featuredTitle}</h2>
        <p class="lead">{d.home.featuredLead}</p>
      </div>
      <a class="btn btn-line" href={href(lang, 'projects')}>{d.cta.seeProjects}</a>
    </div>
    <div class="mosaic">
      {featured.map((f, i) => (
        <figure class={i === 0 ? 'm-big' : undefined}>
          <img src={f.src} width={f.w} height={f.h} alt={f[lang]} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="trust-h">
  <div class="wrap trust-grid">
    <div class="trust-head">
      <h2 id="trust-h">{d.home.trustTitle}</h2>
      <p class="lead">{d.home.trustLead}</p>
    </div>
    <dl class="trust">
      {d.home.trust.map(([mark, label, text]) => (
        <div>
          <dt><span class="mark">{mark}</span> <span class="label">{label}</span></dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section about-teaser" aria-labelledby="about-h">
  <div class="wrap about-grid">
    <img src="/images/chantier-2.webp" width="504" height="504" alt={d.about.teamAlt} loading="lazy" />
    <div class="measure">
      <h2 id="about-h">{d.home.aboutTitle}</h2>
      <p class="about-p">{d.home.aboutText}</p>
      <p><a class="textlink" href={href(lang, 'about')}>{d.home.aboutLink}</a></p>
    </div>
  </div>
</section>

<CtaBand lang={lang} />

<style>
  /* Hero: the logo's half-sun becomes the frame for the strongest photo */
  .hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem); overflow: hidden; background: var(--sauge); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .hero-text { display: grid; gap: 1.5rem; padding-bottom: 1rem; }
  .hero h1 { font-size: clamp(1.9rem, 0.9rem + 5vw, 4.25rem); }
  .since { font-weight: 700; color: var(--thuya); }

  .arch-wrap { position: relative; justify-self: end; width: min(100%, 520px); padding: 16px 16px 0; }
  .arch-wrap::before {
    content: ''; position: absolute; inset: 0 0 0 0;
    border: 2px solid var(--soleil); border-bottom: 0; border-radius: 999px 999px 0 0;
  }
  .arch { aspect-ratio: 5 / 6; border-radius: 999px 999px 0 0; overflow: hidden; background: var(--lichen); }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 60%; }
  @media (prefers-reduced-motion: no-preference) {
    .arch { animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) both 0.1s; }
    .arch-wrap::before { animation: rim 1.1s ease-out both 0.5s; }
  }
  @keyframes rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rim { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .arch-wrap { order: -1; justify-self: center; width: min(100%, 420px); padding: 12px 12px 0; }
    .arch { aspect-ratio: 1 / 1; }
    .hero-text { padding-bottom: 0; }
    .hero .actions .btn { flex: 1 1 14rem; }
  }

  /* Steps: a real sequence, so they are numbered */
  .steps { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .step-link { display: grid; gap: 0.5rem; text-decoration: none; color: inherit; }
  .step img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; border-radius: var(--radius-s); margin-bottom: 0.75rem; }
  /* Big quiet numeral: decorative (aria-hidden), the list itself carries the order */
  .step-n {
    display: block; margin-top: 0.25rem;
    font-size: 2.75rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; color: #9db1a4;
  }
  .step h3 { font-size: var(--step-2); }
  .step-title { font-weight: 700; color: var(--thuya); }
  .step-link p:last-child { color: var(--mousse); }
  .step h3 {
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em;
    text-decoration-color: transparent; transition: text-decoration-color var(--t) var(--ease);
  }
  .step-link:hover h3 { text-decoration-color: var(--soleil); }
  .step img { transition: filter 300ms var(--ease); }
  .step-link:hover img { filter: brightness(1.06) saturate(1.05); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; gap: 1.75rem; } .step-link { grid-template-columns: 7.5rem 1fr; column-gap: 1rem; row-gap: 0.35rem; align-content: start; } .step img { grid-row: 1 / span 4; aspect-ratio: 1; margin: 0; } .step-link > :not(img) { grid-column: 2; } .step-n { font-size: 2rem; margin-top: 0; } }
  @media (max-width: 420px) { .step-link { grid-template-columns: 6rem 1fr; } }

  .feat-head { grid-template-columns: 1fr auto; align-items: end; }
  @media (max-width: 640px) { .feat-head { grid-template-columns: 1fr; } }
  .mosaic { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 0.75rem; aspect-ratio: 2.1 / 1; }
  .mosaic figure { margin: 0; overflow: hidden; border-radius: var(--radius-s); }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; }
  .m-big { grid-row: 1 / span 2; }
  @media (max-width: 760px) {
    .mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: auto; aspect-ratio: auto; }
    .m-big { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 4 / 3; }
    .mosaic figure:not(.m-big) { aspect-ratio: 1; }
  }

  /* Trust: heading on the left, four facts in a 2×2 grid on the right */
  .trust-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .trust-head .lead { margin-top: 1rem; font-size: 1.05rem; }
  .trust { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; margin: 0; }
  .trust > div { border-top: 2px solid var(--thuya); padding-top: 1rem; }
  .trust dt { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.75rem; row-gap: 0.15rem; margin-bottom: 0.4rem; }
  .mark {
    font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--thuya); letter-spacing: -0.01em;
  }
  .label { font-weight: 700; }
  .trust dd { margin: 0; color: var(--mousse); }
  @media (max-width: 860px) { .trust-grid { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 560px) { .trust { grid-template-columns: 1fr; gap: 1.5rem; } }

  .about-teaser { padding-top: 0; }
  .about-grid {
    display: grid; grid-template-columns: minmax(0, 0.8fr) 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center;
    border-top: 1px solid rgba(31, 37, 34, 0.18); padding-top: clamp(3rem, 7vw, 6rem);
  }
  .about-grid img { width: 100%; max-width: 504px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-s); }
  .about-grid h2 { margin-bottom: 1.25rem; }
  .about-p { margin-bottom: 1.25rem; font-size: var(--step-1); line-height: 1.55; }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }
</style>

---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site, routes, type Lang, type RouteKey } from '../data/site';
import { t } from '../data/i18n';

interface Props { lang: Lang; page: RouteKey | null; title?: string; description?: string; }
const { lang, page } = Astro.props;
const d = t(lang);
const meta = page ? d.meta[page] : { title: Astro.props.title ?? site.name, description: Astro.props.description ?? '' };
const canonical = page ? new URL(routes[page][lang], site.url).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.legalName,
  url: site.url,
  logo: new URL('/images/logo-roche.png', site.url).href,
  image: new URL('/images/og.jpg', site.url).href,
  telephone: '+1-514-769-6685',
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3520 rue St-Patrick',
    addressLocality: 'Montréal',
    addressRegion: 'QC',
    postalCode: site.postal,
    addressCountry: 'CA',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
  ],
  areaServed: 'Montréal, QC',
  sameAs: [site.facebook],
};
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {page && <link rel="alternate" hreflang="fr-CA" href={new URL(routes[page].fr, site.url).href} />}
    {page && <link rel="alternate" hreflang="en-CA" href={new URL(routes[page].en, site.url).href} />}
    {page && <link rel="alternate" hreflang="x-default" href={new URL(routes[page].fr, site.url).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={new URL('/images/og.jpg', site.url).href} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta name="theme-color" content="#183a2c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    <Header lang={lang} current={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <MobileBar lang={lang} />
  </body>
</html>

---
import { site, type Lang } from '../data/site';
import { t } from '../data/i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang);
import { quoteHref, quoteRel } from '../lib/paths';
---
<section class="cta" aria-labelledby="cta-h">
  <div class="wrap cta-grid">
    <div>
      <h2 id="cta-h">{d.home.ctaTitle}</h2>
      <p>{d.home.ctaText}</p>
    </div>
    <div class="cta-act">
      <a class="cta-phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn-sun" href={quoteHref(lang)} rel={quoteRel}><Icon name="doc" />{d.cta.quote}</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--lichen); padding-block: clamp(3rem, 7vw, 5.5rem); }
  .cta-grid { display: grid; grid-template-columns: 1fr auto; gap: 2rem 4rem; align-items: center; }
  .cta h2 { margin-bottom: 0.75rem; }
  .cta p { max-width: 32rem; font-size: var(--step-1); line-height: 1.5; }
  .cta-act { display: grid; gap: 1rem; justify-items: start; }
  .cta-phone {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.5rem); font-weight: 800; line-height: 1;
     color: var(--thuya); white-space: nowrap; letter-spacing: -0.02em;
    text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: transparent;
  }
  .cta-phone { padding-block: 0.4rem; }
  .cta-phone:hover { text-decoration-color: var(--soleil); }
  @media (max-width: 860px) { .cta-grid { grid-template-columns: 1fr; } }
</style>

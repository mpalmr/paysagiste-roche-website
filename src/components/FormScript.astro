---
// Shared client-side handling for the contact and careers forms.
//
// Timing: Astro emits this as <script type="module">. Module scripts are deferred, so they run
// once the HTML is fully parsed (just before DOMContentLoaded). The elements queried below always
// exist; a DOMContentLoaded wrapper would add nothing.
//
// Sending:
//   data-send="query"   GET with the fields in the query string (contact form → simpleEmailSender.cgi)
//   default             POST multipart FormData (careers form → sendmailWdoc.pl, with the CV file)
// Optional per-form behaviour, set with data attributes:
//   data-fold-into="message"  fields marked data-fold="Label" are removed from the payload and
//                             prepended to that field as "Label: value" lines, so the old mail
//                             scripts only receive the field names they already know
//   <fieldset data-join=", "> checkboxes in it are sent as one comma-separated value
//   data-file-max / data-file-too-big / data-file-bad-type   file size and type checks
// With no action set (e.g. the hosted preview), the form validates, then says it isn't connected yet.
---
<script>
  // Same pattern the current site's validator accepts.
  const EMAIL = /^[\w\-.+]+@[a-zA-Z0-9.\-]+\.[a-zA-Z0-9]{2,}$/;
  const FILE_TYPES = /\.(pdf|docx?)$/i;
  type Field = HTMLInputElement | HTMLTextAreaElement;

  document.querySelectorAll<HTMLFormElement>('form[data-ajax]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (!status || !btn) return;
    const msg = form.dataset;

    const setErr = (el: Field, text: string) => {
      const box = document.getElementById(`${el.id}-err`);
      el.setAttribute('aria-invalid', text ? 'true' : 'false');
      if (box) box.textContent = text;
    };
    const check = (el: Field) => {
      const v = el.value.trim();
      if (el.required && !v) return setErr(el, msg.required!), false;
      if (el.type === 'email' && v && !EMAIL.test(v)) return setErr(el, msg.badEmail!), false;
      if (el.minLength > 0 && v && v.length < el.minLength) return setErr(el, msg.tooShort ?? msg.required!), false;
      if (el instanceof HTMLInputElement && el.type === 'file' && el.files?.length) {
        const file = el.files[0];
        if (!FILE_TYPES.test(file.name)) return setErr(el, msg.fileBadType!), false;
        if (msg.fileMax && file.size > Number(msg.fileMax)) return setErr(el, msg.fileTooBig!), false;
      }
      setErr(el, '');
      return true;
    };
    const fields = [...form.querySelectorAll<Field>('input.input, textarea.input, input[type=file]')];
    // Errors appear on submit and clear as the person types, so nothing shifts under the pointer
    // between leaving a field and clicking the submit button. File inputs check as soon as one is picked.
    fields.forEach((el) => {
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); });
      if (el.type === 'file') el.addEventListener('change', () => check(el));
    });

    // Live character counter for limited fields.
    form.querySelectorAll<HTMLElement>('.count[data-max]').forEach((counter) => {
      const field = form.querySelector<Field>(`[aria-describedby~="${counter.id}"]`);
      if (!field) return;
      const max = Number(counter.dataset.max);
      const tpl = counter.dataset.template ?? '';
      const update = () => {
        counter.textContent = tpl.replace(/^\d+/, String(field.value.length));
        counter.dataset.near = String(field.value.length >= max - 20);
      };
      field.addEventListener('input', update);
      form.addEventListener('reset', () => setTimeout(update));
    });

    const payload = () => {
      // Copy the form, trimming text values. (FormData.set would collapse repeated names such as
      // several checked boxes into one, so rebuild with append.)
      const data = new FormData();
      for (const [k, v] of new FormData(form).entries()) data.append(k, typeof v === 'string' ? v.trim() : v);
      // Drop an empty file input so the server doesn't receive a 0-byte attachment.
      form.querySelectorAll<HTMLInputElement>('input[type=file]').forEach((f) => { if (!f.files?.length) data.delete(f.name); });
      // Join checkbox groups into one value.
      form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-join]').forEach((fs) => {
        const name = fs.querySelector<HTMLInputElement>('input')?.name;
        if (!name) return;
        const values = data.getAll(name).map(String);
        data.delete(name);
        if (values.length) data.set(name, values.join(fs.dataset.join));
      });
      // Fold extra fields into the message.
      const into = form.dataset.foldInto;
      if (into) {
        const lines: string[] = [];
        form.querySelectorAll<Field>('[data-fold]').forEach((el) => {
          const v = String(data.get(el.name) ?? '');
          data.delete(el.name);
          if (v) lines.push(`${el.dataset.fold}: ${v}`);
        });
        if (lines.length) data.set(into, `${lines.join('\n')}\n\n${data.get(into) ?? ''}`);
      }
      return data;
    };

    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      status.textContent = '';
      const bad = fields.filter((el) => !check(el));
      if (bad.length) { bad[0].focus(); return; }
      const endpoint = form.getAttribute('action');
      if (!endpoint) {
        status.dataset.kind = 'demo';
        status.textContent = msg.demo!;
        status.focus();
        return;
      }
      sending = true;
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      // Don't leave the button disabled forever if the mail script never answers.
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), form.enctype === 'multipart/form-data' ? 60000 : 20000);
      try {
        const data = payload();
        let r: Response;
        if (form.dataset.send === 'query') {
          const q = new URLSearchParams();
          data.forEach((v, k) => { if (typeof v === 'string') q.append(k, v); });
          r = await fetch(`${endpoint}?${q}`, { method: 'GET', signal: ctrl.signal });
        } else {
          r = await fetch(endpoint, { method: 'POST', body: data, signal: ctrl.signal });
        }
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        fields.forEach((el) => setErr(el, ''));
        status.dataset.kind = 'ok';
        status.textContent = msg.sent!;
      } catch {
        status.dataset.kind = 'error';
        status.textContent = msg.error!;
      } finally {
        clearTimeout(timer);
        sending = false;
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        status.focus();
      }
    });
  });
</script>
